{
  "id": "openclaw-scribe",
  "name": "OpenClaw Scribe",
  "description": "Local browser recorder and native meeting transcript source",
  "categories": [
    "productivity"
  ],
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "transcriptSourceProviders": [
      "openclaw-scribe"
    ]
  },
  "transcriptSources": {
    "openclaw-scribe": {
      "name": "OpenClaw Scribe",
      "autoStart": {}
    }
  },
  "cliCommands": [
    {
      "name": "scribe",
      "description": "Set up the browser recorder",
      "hasSubcommands": true
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "port": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 65535,
        "default": 19789
      },
      "extensionIds": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-p]{32}$"
        },
        "uniqueItems": true
      },
      "diarization": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "model"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "device": {
            "type": "string",
            "pattern": "^(auto|cpu|cuda(:[0-9]+)?|metal|vulkan(:[0-9]+)?)$",
            "default": "auto"
          }
        }
      },
      "asr": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "backend"
            ],
            "properties": {
              "backend": {
                "const": "openclaw"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "backend",
              "python",
              "modelDir"
            ],
            "properties": {
              "backend": {
                "const": "gigaam"
              },
              "python": {
                "type": "string",
                "minLength": 1
              },
              "modelDir": {
                "type": "string",
                "minLength": 1
              },
              "device": {
                "type": "string",
                "pattern": "^(auto|cpu|cuda(:[0-9]+)?)$",
                "default": "auto"
              },
              "threads": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64,
                "default": 6
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "backend",
              "command"
            ],
            "properties": {
              "backend": {
                "const": "worker"
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "maxChunkSeconds": {
                "type": "number",
                "minimum": 0.2,
                "maximum": 30,
                "default": 20
              },
              "startupTimeoutSeconds": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 600,
                "default": 120
              },
              "timeoutSeconds": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 1800,
                "default": 120
              }
            }
          }
        ]
      }
    }
  }
}
